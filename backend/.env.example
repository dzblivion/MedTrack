# Copie este arquivo para backend/.env e preencha os valores.

# Banco de dados. Com Docker, estes valores são definidos pelo docker-compose.yml;
# aqui eles só valem para rodar o backend fora do Docker (python app.py).
# Para usar o MySQL do Docker nesse caso: DB_PORT=3307, DB_USER=medtrack, DB_PASSWORD=medtrack.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medtrack

# Chave que assina o token de login (JWT). Obrigatória: use um texto longo e aleatório.
JWT_SECRET=

# Opcional: chave do código de recuperação de senha. Se ficar vazia, usa o JWT_SECRET.
RECUPERACAO_CODIGO_SECRET=

# Gmail que envia o código de recuperação de senha.
# MAIL_PASSWORD é uma "senha de app" do Google (16 letras, sem espaços).
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente do e-mail. Só descomente se for preencher: vazio, o envio falha.
# MAIL_DEFAULT_SENDER=

# Azure Document Intelligence (leitura das receitas pela MIA).
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
